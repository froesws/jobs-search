{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobs-search.local/contracts/provider-config.schema.json",
  "title": "Provider Configuration View",
  "description": "Provider settings returned to the frontend. Never contains a credential value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["providers", "order", "fallbackEnabled", "sessionOverride"],
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "requiresApiKey",
          "hasCredential",
          "credentialSource",
          "model",
          "models",
          "baseUrl",
          "attempts",
          "enabled"
        ],
        "properties": {
          "id": { "enum": ["gemini", "openrouter", "deepseek", "ollama"] },
          "label": { "type": "string", "minLength": 1 },
          "requiresApiKey": { "type": "boolean" },
          "hasCredential": { "type": "boolean" },
          "credentialSource": { "enum": ["credential_store", "env", "none"] },
          "model": { "type": ["string", "null"], "maxLength": 200 },
          "models": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "maxItems": 10
          },
          "baseUrl": { "type": ["string", "null"] },
          "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["gemini", "openrouter", "deepseek", "ollama"] }
    },
    "fallbackEnabled": { "type": "boolean" },
    "sessionOverride": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "models"],
          "properties": {
            "provider": { "enum": ["gemini", "openrouter", "deepseek", "ollama"] },
            "models": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
