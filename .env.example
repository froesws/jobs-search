# Provider selection. LLM_PROVIDER chooses the preferred provider and moves it
# to the front of LLM_PROVIDER_ORDER; the remaining providers stay available as
# fallbacks when LLM_ALLOW_FALLBACK is enabled. Leave LLM_PROVIDER empty to use
# the order as-is.
LLM_PROVIDER=
LLM_PROVIDER_ORDER=gemini,openrouter,deepseek

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Runtime
LLM_ALLOW_FALLBACK=true
LLM_TIMEOUT_SECONDS=45
MATCH_THRESHOLD=50
JOBS_SEARCH_MAX_EVALUATIONS=100
JOBS_SEARCH_LLM_CONCURRENCY=2
RUST_LOG=info
